DATABASE_URL=postgresql://usuario:senha@host:5432/banco
SESSION_SECRET=troque-por-um-texto-grande-e-aleatorio
ADMIN_PASSWORD=troque-esta-senha
# DEFAULT_SECRETARIA_PASSWORD=senha-inicial-igual-para-todas
# DATABASE_SSL=true
# Postgres público frequentemente já traz sslmode=require na URL — o app ativa TLS automaticamente em alguns casos.
# Opcional: caminho dentro do projeto (ex.: dados/inventario.json) ou absoluto dentro do container
# INVENTARIO_JSON_PATH=inventario_computadores.json
#
# Zerar antes de importar (apaga usuários, máquinas, histórico, sessões). Não deixe TRUE fixo na Railway.
# IMPORT_RESET_DATABASE=false
# Opcional ao reimportar: alinhar “confirmados” ao JSON (null no JSON volta a pendente)
# IMPORT_REPLACE_STATUS_FROM_JSON=false
